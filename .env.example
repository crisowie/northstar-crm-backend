PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Local demo uses a fixed, development-only identity. Use supabase in production.
AUTH_MODE=supabase

# Keep these values in this API environment only. Never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Public base URL of this API, including /api. Gmail's OAuth redirect URI is
# `${PUBLIC_API_URL}/outreach/gmail/callback`; click tracking uses this host too.
PUBLIC_API_URL=https://your-public-api.example.com/api
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Base64-encoded 32-byte key. Keep it stable so saved Gmail tokens remain readable.
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Initial outbound provider for users without a saved preference.
EMAIL_PROVIDER=gmail

# Amazon SES API v2 (inactive providers may remain blank).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=
AWS_SES_CONFIGURATION_SET=

# Resend API (opt-in recipients only; never use for cold prospecting).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
