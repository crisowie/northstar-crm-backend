PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
AUTH_MODE=supabase

# Supabase: use your project's API URL and server-side service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public backend base URL, including /api. Telnyx callback is derived as
# ${PUBLIC_API_URL}/voice/webhooks; Gmail OAuth also uses this setting.
PUBLIC_API_URL=https://your-api-host.example/api

# Existing Gmail / email provider settings (configure only the providers you use).
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key
GMAIL_TOKEN_ENCRYPTION_KEY=
EMAIL_PROVIDER=gmail
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=
AWS_SES_CONFIGURATION_SET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Telnyx browser calling. Keep every value on the backend only.
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_SIP_CONNECTION_ID=your-credential-based-sip-connection-id
TELNYX_VOICE_APPLICATION_ID=your-call-control-voice-application-id
TELNYX_PHONE_NUMBER=+1-your-authorized-us-number
TELNYX_PHONE_NUMBER_UK=
TELNYX_PUBLIC_KEY=your-base64-telnyx-webhook-ed25519-public-key
# Set true only after enabling Park Outbound Calls on the SIP connection.
TELNYX_PARK_OUTBOUND_CALLS=false

# Telnyx SMS. Use an SMS-enabled, authorized number; falls back to TELNYX_PHONE_NUMBER.
TELNYX_SMS_FROM_NUMBER=
